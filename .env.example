# ---- Fantasy Draft Compass backend config ----
# Copy to .env and fill in. NEVER commit .env.

# Server
PORT=8080
NODE_ENV=development
# Comma-separated origins allowed to call the API (your front-end URLs)
CORS_ORIGINS=http://localhost:5173,https://app.fantasydraftcompass.com

# Database (Postgres)
DATABASE_URL=postgres://fdc:fdc@localhost:5432/fdc

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=30d
# Comma-separated admin emails (server-side gate — the real authority, not the client list)
ADMIN_EMAILS=rosetc16@gmail.com,trey.rose@pirates.com

# Stripe (payments). Use test keys in development.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID=price_xxx
# Season pass price shown in UI (cents)
SEASON_PASS_CENTS=1999

# Data sources
SLEEPER_BASE=https://api.sleeper.app/v1
# Active NFL season — the refresh job reads this; bump it (or let the season-rollover job flip it)
ACTIVE_SEASON=2026
# League-year cutoff (passes/age-out boundary); ISO date
LEAGUE_YEAR_CUTOFF=2027-03-01

# Harvest tuning
SLEEPER_MAX_CALLS_PER_MIN=800
HARVEST_BATCH=200

# ---- Email (Resend) ----
# Used for BOTH the feedback inbox notifications and the Tuesday weekly brief. Without a key the app
# stores feedback in the admin inbox as normal and the weekly-brief job simply no-ops.
RESEND_API_KEY=
# Verified sender for feedback notifications, e.g. "FDC <alerts@fantasydraftcompass.com>"
FEEDBACK_FROM=
# Where feedback notifications go (comma-separated)
ADMIN_NOTIFY_EMAILS=rosetc16@gmail.com
# Sender for the weekly brief; falls back to FEEDBACK_FROM if unset
BRIEF_FROM=
# Link the weekly brief points at
APP_URL=https://www.fantasydraftcompass.com

# ---- ADP table pruning ----
# adp_observations grows with every harvest pass. The nightly prune keeps a trailing window plus a
# per-format floor. Leaving these at the defaults is fine; they exist so the window can be widened
# without a deploy. (An unpruned table filled the DB and took the site down on 2026-08-05.)
ADP_KEEP_DAYS=21
ADP_MIN_SAMPLE=400
